# Variables para docker compose (copiar a .env y cambiar la contraseña en el servidor)
POSTGRES_USER=mihistorias
POSTGRES_PASSWORD=mihistorias
POSTGRES_DB=mihistorias
POSTGRES_PORT=5433

# Puertos publicados (solo en 127.0.0.1). La API corre en el 6000; la web en el 8080 (en tu PC: http://localhost:8080).
# Desde internet se entra por el Caddy del VPS, no por estos puertos.
API_PORT=6000
WEB_PORT=8080

# Red de Docker de tu Caddy (servidor). Ver deploy/README.md
CADDY_NETWORK=

# En el servidor descomenta estas dos líneas para que baste `docker compose up -d --build`:
# COMPOSE_FILE=docker-compose.yml:deploy/docker-compose.caddy-externo.yml
# COMPOSE_PROFILES=prod

# Sesiones (obligatorio). Genera uno con:
#   node -e "console.log(require('crypto').randomBytes(48).toString('base64url'))"
#   o: openssl rand -base64 48
JWT_SECRET=
# true = cualquiera puede crear cuenta (por defecto). false = solo se puede registrar el primer usuario.
ALLOW_REGISTRATION=true

# Clave de la API de Anthropic (https://console.anthropic.com) para el asistente IA
ANTHROPIC_API_KEY=
